<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The example app on iOS: the package against a sample backend, section by
    section. Builds on macOS only (the ios workload needs Xcode); on Linux its
    sources are compile-checked by tools/ioscheck. Give the backend when
    building:

        dotnet build -p:NecessaryBackendUrl=https://backend.example.com
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.meraj.necessarysdk.example</ApplicationId>
    <ApplicationTitle>Necessary .NET</ApplicationTitle>
    <ApplicationVersion>10</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.10</ApplicationDisplayVersion>
    <RootNamespace>Necessary.Example</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1031</NoWarn>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">ios-arm64</RuntimeIdentifier>
    <CodesignKey Condition="'$(CodesignKey)' == ''"></CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NecessaryBackendUrl" Value="$(NecessaryBackendUrl)" />
    <AssemblyMetadata Include="NecessaryBackends" Value="$(NecessaryBackends)" />
    <Compile Include="../Shared/*.cs" />
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/NecessarySdk/NecessarySdk.csproj" />
  </ItemGroup>

</Project>
