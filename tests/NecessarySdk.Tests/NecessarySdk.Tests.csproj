<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Necessary.Tests</RootNamespace>
    <!-- A machine with only a newer runtime runs the net8.0 tests on it. -->
    <RollForward>LatestMajor</RollForward>
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The example app's shared code: what its screens show, tested here. -->
    <Compile Include="..\..\example\Shared\*.cs" LinkBase="Example" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NecessarySdk\NecessarySdk.csproj" SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>

</Project>
